# ---------------------------------------------------------------------------
# BlaXaura local configuration. Copy to `.env` and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Optional. Leave empty to run entirely offline with the deterministic
# fallback report. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Verified against the Gemini API model docs (Oct 2026). Any text model that
# supports structured output works. If the model is unavailable BlaXaura
# automatically falls back to the local deterministic report.
GEMINI_MODEL=gemini-3.5-flas-lite

# Where the SQLite database lives. Relative paths resolve from the repo root.
DATABASE_PATH=./data/blaxaura.sqlite

# Backend port. The client dev server proxies /api here.
PORT=8787

# Bind host. Keep 127.0.0.1 for normal use. Use 0.0.0.0 ONLY when you
# deliberately want phones on your Wi-Fi to reach it (traffic is unencrypted).
HOST=127.0.0.1

# Admin password bootstrap (optional). If set on first run, this becomes the
# host dashboard password and no setup screen is shown. Minimum 10 characters.
# Leave empty to set the password through /admin on first launch.
ADMIN_PASSWORD=

# Session lifetime for the host dashboard, in hours.
ADMIN_SESSION_HOURS=8

# Gemini request timeout in milliseconds.
GEMINI_TIMEOUT_MS=12000
